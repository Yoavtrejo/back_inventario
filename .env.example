# Copia este archivo como .env y ajusta los valores
# Obligatoria si DJANGO_DEBUG=False. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esto
# Apagado por defecto; ponlo en True solo en desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Necesario en producción con HTTPS para el admin, ej. https://api.midominio.com
CSRF_TRUSTED_ORIGINS=

# Solo con DJANGO_DEBUG=False (producción detrás de HTTPS)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

DB_NAME=bdinventario_redes
DB_USER=postgres
DB_PASSWORD=hola12345
DB_HOST=localhost
DB_PORT=5432
# DB_SSLMODE=require   # para una base de datos remota

# URL del frontend (enlaces en los correos)
FRONTEND_URL=http://localhost:3000

# Correo
# - Desarrollo: imprime los correos en la consola del servidor / del command
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# - Gmail: activa la verificación en dos pasos en la cuenta y genera una
#   "contraseña de aplicación" (https://myaccount.google.com/apppasswords);
#   deja EMAIL_BACKEND sin definir (usa SMTP) y llena:
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Segundos máximos de espera al servidor SMTP
EMAIL_TIMEOUT=10
# Enviar los correos de las vistas en segundo plano (no retrasa la respuesta)
EMAIL_ASYNC=True
